# InfraSight configuration.
#
#   cp .env.example .env
#
# Then, at minimum, replace every value marked CHANGE-ME. This file contains
# no real secrets and is safe to commit; `.env` must never be committed.
#
# Generate strong values with:
#   openssl rand -hex 32

# ============================================================ application
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Port the dashboard is published on (http://localhost:8080 by default).
HTTP_PORT=8080

# Number of uvicorn worker processes for the API.
API_WORKERS=2

# Comma-separated Host allow-list. Leave empty when the bundled nginx
# terminates requests, which is the default topology.
ALLOWED_HOSTS=

# Only needed if you serve the frontend from a different origin than the API.
# Empty is correct for the bundled Compose setup.
CORS_ORIGINS=

# ============================================== compose project identity
# Names the Docker network, the containers and - critically - the postgres
# volume (<project>_postgres_data).
#
# UPGRADING FROM CertMonitor: set this to `certmonitor`. The application was
# renamed to InfraSight, and leaving this at the new default would point the
# stack at a brand-new empty volume while your existing data sat untouched in
# `certmonitor_postgres_data`. One line here keeps everything where it is.
COMPOSE_PROJECT_NAME=infrasight

# =============================================================== database
# UPGRADING FROM CertMonitor: keep these as `certmonitor`. They name the role
# and database that already exist inside your volume; changing them would ask
# Postgres for a database it does not have.
POSTGRES_DB=infrasight
POSTGRES_USER=infrasight
# CHANGE-ME
POSTGRES_PASSWORD=change-me-postgres-password
# Host port for psql/backups; bound to 127.0.0.1 only.
POSTGRES_PORT=5432

# Compose builds DATABASE_URL from the values above. Set it explicitly only
# when pointing at a database outside this stack (RDS, Cloud SQL, ...).
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/infrasight

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ================================================================== redis
# Used for login rate limiting shared across API replicas and for import
# previews. The app falls back to in-process equivalents if unreachable.
REDIS_URL=redis://redis:6379/0

# =============================================================== security
# Signs JWTs, and - unless ENCRYPTION_KEY is set below - derives the key that
# encrypts stored endpoint credentials. CHANGE-ME: at least 32 random
# characters, e.g. `openssl rand -base64 48`.
#
# REQUIRED when APP_ENV is production or staging. The API refuses to start
# without it rather than inventing one per process, because a per-process
# secret means replicas reject each other's tokens and every encrypted
# credential becomes unreadable at the next restart.
#
# Changing it invalidates every existing session, and - if ENCRYPTION_KEY is
# blank - every stored credential with it.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encrypts endpoint credentials and notification-channel configuration at
# rest. Leave blank to derive it from JWT_SECRET; set it explicitly if you
# ever intend to rotate JWT_SECRET without re-entering every credential.
# CHANGE-ME
ENCRYPTION_KEY=

PASSWORD_MIN_LENGTH=10

# Brute-force protection.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
ACCOUNT_LOCKOUT_ATTEMPTS=8
ACCOUNT_LOCKOUT_MINUTES=15

SECURE_COOKIES=true
HSTS_ENABLED=true

# ========================================================= initial admin
# Created on first start only. Never overwritten on restart, so changing
# these values later has no effect on an existing account.
ADMIN_USERNAME=admin
# CHANGE-ME. The bundled default is public knowledge.
ADMIN_PASSWORD=Passwd@123
ADMIN_EMAIL=admin@localhost
# Forces a password change at first sign-in. Keep this true.
ADMIN_FORCE_PASSWORD_CHANGE=true

# ============================================================= monitoring
# Defaults for new endpoints. These are also editable from the Settings
# page at runtime, and a stored setting overrides what is here.
#
# Five minutes is the HEALTHY cadence, and it is not the whole story: an
# endpoint in a fast-check environment (production, by default) is checked
# every minute regardless, and any endpoint that fails drops to a one-minute
# recheck until it passes again. All three are Settings page values
# (fast_check_environments, fast_check_interval, failure_recheck_interval).
DEFAULT_MONITOR_INTERVAL=300
DEFAULT_TIMEOUT=10

# Floor on how often any endpoint may be checked. Enforced server-side so
# an aggressive interval cannot turn the monitor into a load generator.
MIN_MONITOR_INTERVAL=30
MAX_MONITOR_INTERVAL=86400

# Certificate state thresholds, in days remaining.
SSL_WARNING_DAYS=30
SSL_CRITICAL_DAYS=7

# ======================================================== vantage points
# Extra places to check from before believing an endpoint is down. Each entry
# is a proxy this host can reach; the tor-de / tor-us / tor-sg services in
# docker-compose.yml provide three free ones without a second VM.
#
# A vantage verdict can only ever WITHHOLD an incident, never open one. If the
# endpoint answers from Frankfurt while failing here, the fault is more likely
# on the path from this box than at the endpoint, so the incident waits. A
# blocked or timed-out exit counts as no opinion, and the incident opens as it
# would have anyway.
#
# Leave this empty to turn the feature off entirely - the worker then behaves
# exactly as it did before.
# `country` is optional and is what the exit is SUPPOSED to be. Declared rather
# than guessed from `name`, so System Resources can flag a real fallback -
# which happens routinely, because Tor runs with StrictNodes 0 and picks
# another country rather than failing when the requested one has no exit free.
# Leave it out and the observed exit is reported without any claim about it.
VANTAGE_POINTS=[{"name":"Germany","proxy":"socks5://tor-de:9050","country":"DE"},{"name":"United States","proxy":"socks5://tor-us:9050","country":"US"},{"name":"Singapore","proxy":"socks5://tor-sg:9050","country":"SG"}]
VANTAGE_ENABLED=true
# Free exits are slow. Bounded, because the confirmation runs with the failing
# check's database session open.
VANTAGE_TIMEOUT_SECONDS=15
# How many confirmations may run at once across the worker. Extra ones are
# skipped rather than queued, so a large outage cannot stall the check loop.
VANTAGE_CONCURRENCY=3
# Where each vantage's traffic actually comes out, asked on a slow loop and
# shown on the System Resources page. The name in VANTAGE_POINTS is a label;
# this is the fact. Blank it to stop asking anything external.
VANTAGE_ECHO_URL=https://ifconfig.co/json
VANTAGE_STATUS_INTERVAL_SECONDS=900

# Where this worker runs, as you label it - "ap-south-1b", "on-prem-dc2".
# Shown on each worker card. Descriptive only: nothing schedules by it, and it
# is fine to leave empty on a single-worker deployment.
WORKER_REGION=

# ============================================================== captures
# The response body from the last successful check and the last failed one is
# always kept - two rows per endpoint, each replacing the one before it, so
# this never grows with check volume.
#
# Screenshots are the part that needs Chromium. They are opt-in per endpoint
# on the endpoint form; this switch turns them off fleet-wide without
# rebuilding the image. Set it false on a box that cannot spare the memory.
SCREENSHOT_ENABLED=true
# Deliberately far below WORKER_CONCURRENCY: 50 concurrent HTTP checks is
# nothing, 50 concurrent Chromium pages is several gigabytes.
SCREENSHOT_CONCURRENCY=2
SCREENSHOT_TIMEOUT_SECONDS=20
SCREENSHOT_WIDTH=1280
SCREENSHOT_HEIGHT=800
SCREENSHOT_QUALITY=70

# Consecutive failures before an incident opens.
FAILURE_THRESHOLD=3
# Successful-but-slow responses above this are reported as degraded.
RESPONSE_TIME_THRESHOLD_MS=2000
# Suppresses repeat alerts of the same type for the same endpoint.
ALERT_COOLDOWN_MINUTES=30

# High-frequency check results older than this are deleted. Incidents and
# audit logs are kept far longer (see the Settings page).
DATA_RETENTION_DAYS=90

# Refuse to probe loopback/link-local addresses. Only enable if you
# genuinely need to monitor something on the container itself.
ALLOW_LOOPBACK_TARGETS=false

# ================================================================ worker
WORKER_ENABLED=true
# Name this worker reports as. Leave unset: the container ID is used, which is
# already unique per replica, so `docker compose up -d --scale worker=3` works
# with no changes. Only set it for a single, unscaled worker whose name you
# want to control - two replicas sharing one id collapse into one heartbeat.
# WORKER_ID=
# Maximum simultaneous in-flight checks per worker process.
WORKER_CONCURRENCY=50
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=200
WORKER_HEARTBEAT_SECONDS=15
# /health reports the worker unhealthy after this long without a heartbeat.
WORKER_STALE_AFTER_SECONDS=90
# Heartbeats older than this are treated as belonging to a retired worker (a
# rebuilt container), ignored by /health and pruned by the worker. Stops a
# single rebuild from pinning the status at "degraded" forever.
WORKER_RETIRE_AFTER_SECONDS=300
RETENTION_SWEEP_INTERVAL_SECONDS=3600

# Database pool for the worker container specifically.
WORKER_DB_POOL_SIZE=10
WORKER_DB_MAX_OVERFLOW=10

# =============================================================== imports
MAX_IMPORT_ROWS=5000
MAX_UPLOAD_BYTES=10485760

# ================================================================= build
IMAGE_TAG=latest
